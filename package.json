{
  "name": "fixdev-erp-saas",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "test": "npm run test:unit && npm run test:security",
    "test:security": "vitest run --config vitest.security.config.ts",
    "test:integration": "echo 'No integration tests found'",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "clean": "rm -rf dist",
    "lint": "eslint src/ --ext .ts,.tsx && tsc --noEmit",
    "lint:fix": "eslint src/ --ext .ts,.tsx --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx}\"",
    "prepare": "husky",
    "test:browser": "playwright test",
    "test:e2e": "playwright test",
    "test:e2e:setup": "NODE_ENV=test ALLOW_DB_MIGRATIONS=1 E2E_SEED_CONFIRM=devtes tsx scripts/setup-e2e.ts",
    "preflight:e2e": "tsx scripts/preflight-e2e.ts",
    "test:e2e:ci": "npm run preflight:e2e -- --check-db && npm run test:e2e:setup && CI=1 TEST_E2E_SERVER=1 playwright test",
    "test:e2e:services": "npm run test:e2e:setup && TEST_E2E_SERVER=1 playwright test tests/e2e/service-workflow.spec.ts",
    "test:unit": "vitest run",
    "db:migrate": "tsx scripts/migrate.ts",
    "backup:restore-drill": "tsx scripts/restore-drill.ts",
    "db:seed:test-superadmin": "tsx scripts/seed-test-superadmin.ts",
    "db:seed:e2e": "tsx scripts/seed-e2e-services.ts",
    "db:migrate:production": "DOTENV_CONFIG_PATH=/etc/fixdev/fixdev.production.env FIXDEV_PROFILE=production FIXDEV_DATABASE_NAME=fixdev tsx scripts/migrate.ts",
    "validate": "npm run lint && npm run build",
    "preflight:production": "npm run lint && npm test && npm run build"
  },
  "lint-staged": {
    "src/**/*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ]
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "axios": "^1.18.1",
    "bcrypt": "^6.0.0",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "express-rate-limit": "^8.5.2",
    "html5-qrcode": "^2.3.8",
    "jsonwebtoken": "^9.0.3",
    "jsqr": "^1.4.0",
    "jwt-simple": "^0.5.6",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "nodemailer": "^9.0.3",
    "pg": "^8.22.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "react": "^19.0.1",
    "react-barcode": "^1.6.1",
    "react-dom": "^19.0.1",
    "recharts": "^3.9.1",
    "vite": "^6.2.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.61.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@tsconfig/node20": "^20.1.9",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/pg": "^8.20.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitest/ui": "^4.1.10",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "lint-staged": "^17.2.0",
    "playwright": "^1.61.1",
    "prettier": "^3.9.4",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "typescript-eslint": "^8.65.0",
    "vite": "^6.2.3",
    "vitest": "^4.1.10"
  },
  "allowScripts": {
    "bcrypt@6.0.0": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.1": true
  }
}
